<?xml version="1.0"?>
<psalm
    errorLevel="7"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\LaravelPlugin\Plugin"/>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
    </plugins>
    <!--
        There is no stable vimeo/psalm 7.0.0 release yet, and the tagged betas can't
        satisfy sebastian/diff ^9.0 required by our phpunit/phpunit version, so we're
        pinned to dev-master. That build has a genuine internal bug: $depth and
        $root_scope in StatementsAnalyzer are read but never assigned anywhere in
        Psalm's own source, which corrupts its reference-counting and produces false
        positives for these four issue types even on trivially-used parameters
        (verified with a minimal repro outside this project). Remove this block once
        a stable vimeo/psalm 7.x release fixes the underlying bug.
    -->
    <issueHandlers>
        <UnusedParam errorLevel="suppress"/>
        <PossiblyUnusedParam errorLevel="suppress"/>
        <UnusedClosureParam errorLevel="suppress"/>
        <MissingPureAnnotation errorLevel="suppress"/>
    </issueHandlers>
</psalm>
